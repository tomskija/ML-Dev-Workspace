{
  "name": "Point-Cloud-ML (workspace)",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "pointcloud",
  "runServices": [
    "pointcloud",
    "mlflow",
    "pointcloud-api",
    "ui"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [],
  "portsAttributes": {
    "5050": {
      "label": "MLflow UI (shared)",
      "onAutoForward": "notify"
    },
    "8103": {
      "label": "API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "ML Platform UI",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "root"
}
