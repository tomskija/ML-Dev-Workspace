{
  "name": "Production-Prediction-ML (workspace)",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "ppml",
  "runServices": [
    "ppml",
    "mlflow",
    "postgres",
    "ppml-api",
    "ui"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "5050": {
      "label": "MLflow UI (shared)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Dev server",
      "onAutoForward": "notify"
    },
    "8100": {
      "label": "API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "ML Platform UI",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "cd /workspace/frontend && npm install"
}
